{
  "name": "courseos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src tests",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite preview --host 0.0.0.0 --port 8000 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "report:rationale": "COURSEOS_WRITE_REPORTS=1 vitest run tests/rationale.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "decimal.js": "^10.6.0",
    "docx": "^9.11.0",
    "lucide-react": "^0.468.0",
    "pptxgenjs": "^3.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
